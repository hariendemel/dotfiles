# One shell command per line, run on every `chezmoi apply` where this file
# has changed. Failures are ignored (e.g. "already installed") so re-running
# is always safe — each line should be a one-off setup command, not something
# that needs real idempotency logic.

gh extension install dlvhdr/gh-dash
gh extension install dlvhdr/gh-enhance

herdr plugin install qu8n/herdr-automatic-rename --yes
herdr plugin install ChmaraX/herdr-nvim
