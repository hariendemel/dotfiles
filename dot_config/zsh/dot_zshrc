# --- history ---
HISTFILE="$XDG_STATE_HOME/zsh/history"
HISTFILESIZE=100000
HISTSIZE=100000

setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_FIND_NO_DUPS

# --- shell ---
setopt AUTOCD
setopt NOBEEP
setopt NUMERIC_GLOB_SORT 

# --- smart navigation ---
LF_ICONS=$(cat ~/.config/lf/icons | tr '\n' ':')
export LF_ICONS

eval "$(zoxide init zsh)"

# --- completion system ---
fpath=(/opt/homebrew/share/zsh/site-functions $fpath)
autoload -Uz compinit
compinit -d "$XDG_CACHE_HOME/zsh/zcompdump"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'  # lowercase input matches upper and lower
source <(carapace _carapace zsh)

# --- fuzzy finder ---
if [[ -f /opt/homebrew/opt/fzf/shell/key-bindings.zsh ]]; then
  source /opt/homebrew/opt/fzf/shell/key-bindings.zsh
  source /opt/homebrew/opt/fzf/shell/completion.zsh
fi

# --- fzf-tab: replace default completion menu with fzf popup ---
# fzf-tab must be sourced AFTER compinit (handled by plugin.zsh below)
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls --color $realpath'
zstyle ':fzf-tab:complete:git-checkout:*' fzf-preview 'git log --oneline --graph --color $word 2>/dev/null'
zstyle ':fzf-tab:complete:git-log:*' fzf-preview 'git show --color $word 2>/dev/null'
zstyle ':fzf-tab:complete:kill:*' fzf-preview 'ps -p $word -o pid,comm 2>/dev/null'
zstyle ':fzf-tab:complete:**' fzf-preview 'bat --color=always --style=plain,numbers --line-range=:500 $realpath 2>/dev/null || ls --color $realpath 2>/dev/null || echo $word'
zstyle ':fzf-tab:complete:**' popup-min-size 30
zstyle ':fzf-tab:*' fzf-flags --height=60% --layout=reverse --border=rounded
zstyle ':fzf-tab:*' switch-group '<' '>'

# --- modular config ---
for f in $ZDOTDIR/alias/alias*.zsh; do
  [[ -f $f ]] && source "$f"
done
source "$ZDOTDIR/fzf.zsh"
source "$ZDOTDIR/plugin.zsh"
source "$ZDOTDIR/prompt.zsh"
source "$ZDOTDIR/git.zsh"

