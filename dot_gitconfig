[user]
    name = Harien de Mel
    email = mail@harien.dev

[help]
    autocorrect = 1

[core]
    autocrlf = input
    excludesfile = /Users/harien/.gitignore

[interactive]
    diffFilter = delta --color-only

[pager]
    blame = delta
    diff = diffnav

[delta]
    navigate = true
    line-numbers = true
    side-by-side = true
    features = catppuccin-mocha

[include]
    path = ~/.config/git/config-catppuccin-delta

[pull]
    rebase = true

[rebase]
    autoStash = true

[includeIf "gitdir:~/src/fb/"]
    path = ~/.config/git/config-fb


[fetch]
	prune = true
